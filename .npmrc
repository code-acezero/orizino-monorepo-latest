# Force-include platform-native optional dependencies required by
# Tailwind CSS v4 / @tailwindcss/postcss (lightningcss-linux-x64-gnu).
# We use `--include=optional` here (not `optional=true`) because it works
# across npm 10.8 - 10.9+ without conflicting with the implicit `omit` default.
include=optional
legacy-peer-deps=true
